---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { mitre, attackVersion, attackRetrieved } from '../data/mitre.js';
import { fight, fightBuild } from '../data/fight.js';
import { protocols } from '../data/protocols.js';
import { layers } from '../data/layers.js';

const controls = await getCollection('controls');

// Index: corpus entry -> the controls that cite it. Computed at build time, so the
// page cannot drift from the controls the way a hand-kept table would.
const byId = {};
for (const c of controls) {
  for (const r of c.data.mitre ?? []) (byId[r.id] ??= []).push({ c, relation: r.relation });
  for (const r of c.data.fight ?? []) (byId[r.id] ??= []).push({ c, relation: r.relation });
}

const rfEntries = [
  ...Object.entries(mitre).filter(([, v]) => v.rf && v.kind !== 'mitigation')
    .map(([id, v]) => ({ id, ...v, corpus: `ATT&CK ${v.matrix}` })),
  ...Object.entries(fight).filter(([, v]) => v.rf).map(([id, v]) => ({ id, ...v, corpus: 'FiGHT' })),
];
const covered = rfEntries.filter((e) => byId[e.id]?.length);
const gaps = rfEntries.filter((e) => !byId[e.id]?.length);
const pct = (n) => Math.round((n / rfEntries.length) * 100);

// The reverse direction: RFSAM ground that no corpus models at all.
const uncharted = controls.filter((c) => c.data.threatMapNote)
  .map((c) => ({ id: c.data.id, slug: c.id, note: c.data.threatMapNote }));

const mitigations = Object.entries(mitre).filter(([, v]) => v.kind === 'mitigation');
const COLOR = { enterprise: 'var(--cyan)', ics: 'var(--amber)', mobile: 'var(--purple)' };

// --- Heatmap: protocol x layer, coloured by how the cell relates to the corpora.
const LAYER_ORDER = layers.map((l) => l.id);
const cellOf = (pid, lid) => {
  const cs = controls.filter((c) => c.data.protocol === pid && c.data.layer === lid);
  if (!cs.length) return { state: 'none', label: '' };
  const refs = cs.reduce((n, c) => n + (c.data.mitre?.length ?? 0) + (c.data.fight?.length ?? 0), 0);
  const declared = cs.some((c) => c.data.threatMapNote);
  const href = `/RFSAM/controls/${cs[0].id}`;
  if (refs) return { state: 'mapped', label: String(refs), href, title: `${cs.map((c) => c.data.id).join(', ')}: ${refs} corpus ${refs === 1 ? 'entry' : 'entries'}` };
  if (declared) return { state: 'uncharted', label: '∅', href, title: `${cs[0].data.id}: no corpus models this` };
  return { state: 'unmapped', label: '?', href, title: `${cs.map((c) => c.data.id).join(', ')}: control exists, cites nothing yet` };
};
const heat = protocols.map((p) => ({ p, cells: LAYER_ORDER.map((lid) => ({ lid, ...cellOf(p.id, lid) })) }));

// --- Per-corpus bars
const corpora = [
  { key: 'enterprise', label: 'ATT&CK Enterprise' },
  { key: 'ics', label: 'ATT&CK ICS' },
  { key: 'mobile', label: 'ATT&CK Mobile' },
  { key: 'fight', label: 'FiGHT' },
];
const byCorpus = corpora.map((c) => {
  const list = rfEntries.filter((e) => (c.key === 'fight' ? e.corpus === 'FiGHT' : e.matrix === c.key));
  const done = list.filter((e) => byId[e.id]?.length).length;
  return { ...c, total: list.length, done, pct: list.length ? Math.round((done / list.length) * 100) : 0 };
}).filter((c) => c.total);
---
<BaseLayout title="Adversary-behaviour mapping">
  <div class="container" style="max-width:900px">
    <h1 style="font-size:34px">Adversary-behaviour mapping</h1>
    <p style="color:var(--mut);margin-top:8px;max-width:70ch">
      Where RFSAM controls line up with MITRE ATT&CK and MITRE FiGHT, and, more usefully, where they
      do not. The mapping is a navigation aid, never a coverage score: a control is not a technique, and
      an unmapped technique is a question, not a failure. ATT&CK {attackVersion}, retrieved {attackRetrieved};
      FiGHT build {fightBuild}.
    </p>

    <div class="mono" style="display:flex;gap:14px;flex-wrap:wrap;margin-top:16px;font-size:11px;color:var(--mut2)">
      <span>{rfEntries.length} RF-relevant corpus entries:</span>
      <span style="color:var(--green)">{covered.length} mapped · {pct(covered.length)}%</span>
      <span style="color:var(--amber)">{gaps.length} with no control · {pct(gaps.length)}%</span>
      <span style="color:var(--purple)">{uncharted.length} controls no corpus models</span>
    </div>

    <div class="heat-wrap">
      <div class="heat">
        <div class="hcorner"></div>
        {LAYER_ORDER.map((lid) => <div class="hhead mono">{lid}</div>)}
        {heat.map((row) => (
          <Fragment>
            <a class="hname" href={`/RFSAM/controls/${row.p.id.toLowerCase()}`}>{row.p.name}</a>
            {row.cells.map((c) => (c.href
              ? <a class={`hcell m-${c.state}`} href={c.href} title={c.title}>{c.label}</a>
              : <div class={`hcell m-${c.state}`} title="not scoped">{c.label}</div>))}
          </Fragment>
        ))}
      </div>
    </div>
    <div class="heat-legend mono">
      <span><i class="c-mapped"></i> cites the corpora (number of entries)</span>
      <span><i class="c-uncharted"></i> ∅ no corpus models this</span>
      <span><i class="c-unmapped"></i> ? control exists, cites nothing yet</span>
      <span><i class="c-none"></i> no control</span>
    </div>

    <div style="display:grid;gap:8px;margin-top:26px;max-width:560px">
      {byCorpus.map((c) => (
        <div>
          <div class="mono" style="display:flex;font-size:11px;color:var(--mut2)">
            <span>{c.label}</span>
            <span style="margin-left:auto">{c.done}/{c.total} · {c.pct}%</span>
          </div>
          <div style="height:8px;border-radius:4px;background:rgba(34,52,74,.5);overflow:hidden;margin-top:4px">
            <div style={`height:100%;width:${c.pct}%;background:rgba(63,209,124,.9)`}></div>
          </div>
        </div>
      ))}
    </div>

    <h2 class="mono" style="font-size:12px;letter-spacing:.14em;color:var(--mut2);margin-top:36px">MAPPED</h2>
    {covered.map((e) => (
      <div style="padding:10px 14px;background:var(--bg2);border:1px solid var(--line);border-radius:8px;margin-bottom:6px">
        <div style="display:flex;gap:12px;align-items:baseline;flex-wrap:wrap">
          <a href={e.url} target="_blank" rel="noopener" class="mono" style={`font-size:11.5px;color:${COLOR[e.matrix] ?? 'var(--green)'};width:110px`}>{e.id} ↗</a>
          <span style="font-size:13.5px">{e.title}</span>
          <span class="mono" style="margin-left:auto;font-size:10px;color:var(--mut2)">{e.corpus}</span>
        </div>
        <div class="mono" style="font-size:11px;color:var(--mut);margin-top:6px;padding-left:122px">
          {byId[e.id].map(({ c, relation }) => (
            <a href={`/RFSAM/controls/${c.id}`} style="color:var(--amber);margin-right:10px">{c.data.id} <span style="color:var(--mut2)">({relation})</span></a>
          ))}
        </div>
      </div>
    ))}

    <h2 class="mono" style="font-size:12px;letter-spacing:.14em;color:var(--mut2);margin-top:36px">NO CONTROL YET</h2>
    <p style="color:var(--mut);font-size:13.5px;max-width:70ch">
      RF-relevant entries that no control cites. Some are real gaps in the methodology; others are
      techniques a control already exercises without saying so. The hint says which.
    </p>
    {gaps.map((e) => (
      <div style="padding:10px 14px;border-left:2px solid var(--line2);margin:8px 0">
        <div style="display:flex;gap:12px;align-items:baseline;flex-wrap:wrap">
          <a href={e.url} target="_blank" rel="noopener" class="mono" style={`font-size:11.5px;color:${COLOR[e.matrix] ?? 'var(--green)'};width:110px`}>{e.id} ↗</a>
          <span style="font-size:13.5px">{e.title}</span>
          <span class="mono" style="margin-left:auto;font-size:10px;color:var(--mut2)">{e.corpus}</span>
        </div>
        {e.gapHint && <p style="font-size:12.5px;color:var(--mut);margin-top:5px;padding-left:122px">{e.gapHint}</p>}
      </div>
    ))}

    <h2 class="mono" style="font-size:12px;letter-spacing:.14em;color:var(--mut2);margin-top:36px">GROUND NO CORPUS MODELS</h2>
    <p style="color:var(--mut);font-size:13.5px;max-width:70ch">
      The reverse direction, and the reason this page is not a score. These controls assess threats
      that ATT&CK and FiGHT do not describe at all.
    </p>
    {uncharted.map((u) => (
      <div style="padding:10px 14px;border-left:2px solid var(--amber);margin:8px 0">
        <a href={`/RFSAM/controls/${u.slug}`} class="mono" style="font-size:11.5px;color:var(--amber)">{u.id}</a>
        <p style="font-size:12.5px;color:var(--mut);line-height:1.6;margin-top:5px">{u.note}</p>
      </div>
    ))}

    <p class="mono" style="font-size:11px;color:var(--mut2);margin-top:36px;line-height:1.7">
      Remediation anchors: {mitigations.map(([id, v]) => <a href={v.url} target="_blank" rel="noopener" style="color:var(--mut);margin-right:8px">{id} {v.title}</a>)}
      <br />ATT&CK® is a registered trademark of The MITRE Corporation. © 2026 The MITRE Corporation.
      This work is reproduced and distributed with the permission of The MITRE Corporation.
    </p>
  </div>
</BaseLayout>

<style>
  .heat-wrap { overflow-x: auto; margin-top: 22px; padding-bottom: 4px; }
  .heat { display: grid; grid-template-columns: 124px repeat(7, minmax(32px, 1fr)); gap: 5px; min-width: 420px; }
  .heat .hhead { font-size: 10px; text-align: center; letter-spacing: .06em; align-self: end; padding-bottom: 3px; color: var(--mut2); }
  .heat .hname { font-size: 12px; color: var(--mut); display: flex; align-items: center; height: 34px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 6px; text-decoration: none; }
  .heat .hname:hover { color: var(--ink); }
  .heat .hcell { height: 34px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 12px; border: 1px solid transparent; color: inherit; text-decoration: none; }
  .m-mapped { background: rgba(63,209,124,.9); color: #07120b; font-weight: 700; }
  .m-uncharted { background: rgba(255,194,75,.12); color: var(--amber); border-color: rgba(255,194,75,.55); }
  .m-unmapped { background: rgba(122,162,247,.10); color: var(--cyan); border: 1px dashed rgba(122,162,247,.45); }
  .m-none { background: rgba(34,52,74,.3); }
  .heat-legend { display: flex; flex-wrap: wrap; gap: 7px 16px; margin-top: 12px; font-size: 11px; color: var(--mut2); }
  .heat-legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: middle; margin-right: 5px; }
  .heat-legend .c-mapped { background: rgba(63,209,124,.9); }
  .heat-legend .c-uncharted { background: rgba(255,194,75,.12); border: 1px solid rgba(255,194,75,.55); }
  .heat-legend .c-unmapped { background: rgba(122,162,247,.10); border: 1px dashed rgba(122,162,247,.45); }
  .heat-legend .c-none { background: rgba(34,52,74,.5); }
</style>
