---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Renders the runner's own reports. A deliberately small Markdown subset (the
// one render_report.py and soa.py emit) rather than a new dependency: the repo
// ships four, and a report viewer does not justify a fifth.
const LOOT = path.resolve('loot');
const files = fs.existsSync(LOOT)
  ? fs.readdirSync(LOOT).filter((f) => f.endsWith('.md')).sort()
  : [];
const which = Astro.url.searchParams.get('f');
const pick = files.includes(which ?? '') ? which : (files.includes('report.md') ? 'report.md' : files[0]);
const raw = pick ? fs.readFileSync(path.join(LOOT, pick), 'utf8') : '';

const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
const inline = (s: string) => esc(s)
  .replace(/`([^`]+)`/g, '<code>$1</code>')
  .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

function render(md: string): string {
  const out: string[] = [];
  const lines = md.split('\n');
  let i = 0;
  while (i < lines.length) {
    const l = lines[i];
    const h = /^(#{1,4})\s+(.*)$/.exec(l);
    if (h) { const n = h[1].length; out.push(`<h${n}>${inline(h[2])}</h${n}>`); i++; continue; }
    if (l.startsWith('```')) {                       // fenced code
      const buf: string[] = []; i++;
      while (i < lines.length && !lines[i].startsWith('```')) buf.push(lines[i++]);
      i++; out.push(`<pre><code>${esc(buf.join('\n'))}</code></pre>`); continue;
    }
    if (l.startsWith('|')) {                          // table
      const rows: string[][] = [];
      while (i < lines.length && lines[i].startsWith('|')) {
        const cells = lines[i].slice(1, -1).split('|').map((c) => c.trim());
        if (!/^-+$/.test(cells[0].replace(/[\s:-]/g, '') || '-')) rows.push(cells);
        i++;
      }
      const [head, ...body] = rows.filter((r) => !r.every((c) => /^:?-+:?$/.test(c)));
      out.push('<table><thead><tr>' + head.map((c) => `<th>${inline(c)}</th>`).join('')
        + '</tr></thead><tbody>'
        + body.map((r) => '<tr>' + r.map((c) => `<td>${inline(c)}</td>`).join('') + '</tr>').join('')
        + '</tbody></table>');
      continue;
    }
    if (l.startsWith('> ')) {                         // blockquote
      const buf: string[] = [];
      while (i < lines.length && lines[i].startsWith('> ')) buf.push(lines[i++].slice(2));
      out.push(`<blockquote>${inline(buf.join(' '))}</blockquote>`); continue;
    }
    if (/^[-*]\s+/.test(l)) {                         // list
      const buf: string[] = [];
      while (i < lines.length && /^[-*]\s+/.test(lines[i])) buf.push(lines[i++].replace(/^[-*]\s+/, ''));
      out.push('<ul>' + buf.map((b) => `<li>${inline(b)}</li>`).join('') + '</ul>'); continue;
    }
    if (l.trim() === '---') { out.push('<hr>'); i++; continue; }
    if (!l.trim()) { i++; continue; }
    // Paragraph. The first line is always consumed, whatever it starts with:
    // otherwise a line that begins with a block marker but matched no block rule
    // above would leave `i` unmoved and spin this loop forever.
    const buf: string[] = [lines[i++]];
    while (i < lines.length && lines[i].trim() && !/^[#>|`-]/.test(lines[i])) buf.push(lines[i++]);
    out.push(`<p>${inline(buf.join(' '))}</p>`);
  }
  return out.join('\n');
}
const html = render(raw);
const isSoa = (pick ?? '').startsWith('soa');
---
<BaseLayout title="Reports (demo)">
  <div class="container" style="max-width:900px">
    <h1 style="font-size:32px">Reports <span class="mono" style="font-size:12px;color:var(--mut2)">demo</span></h1>
    <p class="mono" style="font-size:11.5px;color:var(--mut2);line-height:1.8;margin-top:8px">
      Two kinds, answering different questions. The <strong>Statement of Applicability</strong> is the
      before: which of the 51 controls this engagement may run, and a justified reason for every one it
      may not. The <strong>session report</strong> is the after: what was actually exercised and what it
      showed. Both regenerate from the JSONL under <code>loot/</code>.
    </p>

    <div class="mono" style="display:flex;gap:7px;flex-wrap:wrap;margin:18px 0 6px">
      {files.map((f) => (
        <a class={`vbadge fchip ${f === pick ? 'sel' : ''}`} href={`/RFSAM/demo/report?f=${f}`}>{f}</a>
      ))}
      <a class="vbadge fchip" href="/RFSAM/demo/session" style="color:var(--cyan)">&larr; session</a>
    </div>

    {pick && <p class="mono" style="font-size:10.5px;color:var(--mut2)">
      source: <code>loot/{pick}</code> · {isSoa ? 'generated by runner/soa.py' : 'generated by runner/render_report.py'}
    </p>}

    <article class="rpt" set:html={html} />
  </div>
</BaseLayout>

<style is:global>
  .vbadge { font-family: var(--mono); font-size: 10px; padding: 3px 8px; border-radius: 3px;
            border: 1px solid var(--line2); letter-spacing: .06em; text-decoration: none; color: var(--mut); }
  .vbadge.sel { color: var(--amber); background: var(--bg2); box-shadow: inset 0 0 0 1px currentColor; }
  .rpt { margin-top: 20px; line-height: 1.75; }
  .rpt h1 { font-size: 24px; margin: 26px 0 10px; }
  .rpt h2 { font-size: 17px; margin: 30px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .rpt h3 { font-size: 13px; margin: 22px 0 8px; font-family: var(--mono); color: var(--amber); letter-spacing: .04em; }
  .rpt p { font-size: 13.5px; color: var(--mut); margin: 10px 0; }
  .rpt code { font-family: var(--mono); font-size: 11.5px; background: var(--bg2);
              padding: 1px 5px; border-radius: 3px; }
  .rpt pre { background: var(--bg2); border: 1px solid var(--line); border-radius: 6px;
             padding: 10px 12px; overflow-x: auto; }
  .rpt pre code { background: none; padding: 0; }
  .rpt table { width: 100%; border-collapse: collapse; margin: 12px 0; font-size: 12px; }
  .rpt th { text-align: left; font-family: var(--mono); font-size: 10px; letter-spacing: .06em;
            color: var(--mut2); border-bottom: 1px solid var(--line2); padding: 6px 8px; }
  .rpt td { border-bottom: 1px solid var(--line); padding: 7px 8px; vertical-align: top; color: var(--mut); }
  .rpt blockquote { border-left: 2px solid var(--amber); margin: 14px 0; padding: 8px 14px;
                    background: var(--bg2); border-radius: 0 6px 6px 0; font-size: 12.5px; }
  .rpt ul { margin: 10px 0 10px 18px; font-size: 13px; color: var(--mut); }
  .rpt hr { border: 0; border-top: 1px solid var(--line); margin: 24px 0; }
</style>
