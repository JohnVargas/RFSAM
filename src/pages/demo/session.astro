---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { protocols } from '../../data/protocols.js';
import { layers } from '../../data/layers.js';

// Reads the runner's own files. In `npm run dev` this page hot-reloads whenever
// record_result.py appends a row, which is the whole live-report effect - no
// server, no database, no polling.
const LOOT = path.resolve('loot');
const jsonl = (f) => fs.existsSync(path.join(LOOT, f))
  ? fs.readFileSync(path.join(LOOT, f), 'utf8').split('\n').filter(Boolean).map((l) => JSON.parse(l))
  : [];
const scope = JSON.parse(fs.readFileSync(path.join(LOOT, 'scope.json'), 'utf8'));
const plan = jsonl('session_plan.jsonl');
const results = jsonl('results.jsonl');
// The execution log, grouped per control. Simulated for now: run_session.py emits
// these as it replays the script, so the same view works unchanged once a real
// engine writes real events.
const events = jsonl('events.jsonl');
const logByControl = {};
for (const e of events) {
  if (!e.control) continue;
  (logByControl[e.control] ??= []).push(e);
}
const byControl = Object.fromEntries(results.map((r) => [r.control, r]));

const V = {
  finding:      { label: 'FINDING',      cls: 'v-finding' },
  passed:       { label: 'PASSED',       cls: 'v-passed' },
  inconclusive: { label: 'INCONCLUSIVE', cls: 'v-inconc' },
  blocked:      { label: 'BLOCKED',      cls: 'v-blocked' },
  pending:      { label: 'PENDING',      cls: 'v-pending' },
};
const count = (v) => results.filter((r) => r.verdict === v).length;
// Counts over the whole plan, so PENDING is a filterable tag too: a control nobody
// has touched is a state worth looking at, not an absence.
const verdictOf = (row) => byControl[row.control]?.verdict ?? 'pending';
const countAll = (v) => plan.filter((row) => verdictOf(row) === v).length;
const LAYERS = ['IG', 'SP', 'PHY', 'LL', 'CR', 'AT', 'AP'];

// --- Progress map: the whole corpus, coloured by what this session did to it.
// Showing only the 9 controls in scope would answer "how far through the list am
// I"; showing all 51 answers "how much of the methodology does this engagement
// actually reach", which is the more honest question and the one the SoA asks.
const corpus = await getCollection('controls');
const inPlan = new Set(plan.map((r) => r.control));
const planByControl = Object.fromEntries(plan.map((r) => [r.control, r]));
const scopedProtocols = new Set(plan.map((r) => r.protocol));

// A protocol/layer pair can hold more than one control (BLE has two at SP and two
// at LL), so a cell aggregates rather than picking one and hiding the rest.
const stateOfOne = (ctrl) => {
  if (!inPlan.has(ctrl.data.id)) return 'out';
  const row = planByControl[ctrl.data.id];
  if (row?.state === 'running') return 'running';
  const r = byControl[ctrl.data.id];
  if (r) return r.verdict;
  if (row?.state === 'blocked') return 'blocked';
  return 'pending';
};
// Worst-first: what is moving now, then what stopped the session, then what it
// found. A cell must never look calmer than the most serious thing inside it.
const RANK = ['running', 'blocked', 'finding', 'inconclusive', 'pending', 'passed', 'out'];

const cellState = (ctrls) => {
  if (!ctrls?.length) return { state: 'none', label: '' };
  const states = ctrls.map(stateOfOne);
  const state = RANK.find((r) => states.includes(r)) ?? 'out';
  const label = ctrls.length > 1 && state !== 'out'
    ? String(ctrls.length)
    : { running: '●', blocked: 'B', out: '·', pending: '·' }[state] ?? (V[state]?.label.slice(0, 1) ?? '?');
  const title = ctrls.map((c, i) => `${c.data.id} — ${states[i]}`).join(' · ');
  return { state, label, title };
};

const byPL = {};
for (const c of corpus) (byPL[`${c.data.protocol}|${c.data.layer}`] ??= []).push(c);
// Protocols that have any control at all, scoped ones first so the live part of
// the map is at the top instead of buried among the untouched rows.
const mapRows = protocols
  .filter((p) => LAYERS.some((l) => byPL[`${p.id}|${l}`]))
  .map((p) => ({
    p,
    scoped: scopedProtocols.has(p.id),
    cells: LAYERS.map((l) => ({ l, ...cellState(byPL[`${p.id}|${l}`]) })),
  }))
  .sort((a, b) => Number(b.scoped) - Number(a.scoped));
const reached = corpus.filter((c) => inPlan.has(c.data.id)).length;
const pct = (n) => plan.length ? Math.round((n / plan.length) * 100) : 0;
const SEV = { critical: 'var(--red, #E06C75)', high: 'var(--orange)', medium: 'var(--amber)', low: 'var(--cyan)', info: 'var(--mut)' };
const mmss = (s) => s ? `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, '0')}s` : '—';
---
<BaseLayout title="Session runner (demo)">
  <div class="container" style="max-width:900px">
    <h1 style="font-size:32px">Session runner <span class="mono" style="font-size:12px;color:var(--mut2)">demo</span></h1>

    {scope.simulated && (
      <div style="border:1px solid var(--amber);background:rgba(255,194,75,.08);border-radius:8px;padding:12px 16px;margin-top:14px">
        <strong class="mono" style="font-size:11px;color:var(--amber);letter-spacing:.08em">SIMULATED SESSION — NOT A REAL ASSESSMENT</strong>
        <p style="font-size:13px;color:var(--mut);margin-top:6px;line-height:1.6">{scope.note}</p>
      </div>
    )}

    <p style="color:var(--mut);margin-top:16px;max-width:70ch;font-size:14px">
      The engine walks the controls in scope, records one row per control whether or not there was a
      finding, and this page re-renders from those rows. A control that was tested and held is not the
      same as one nobody touched — that distinction is what makes the coverage number mean anything.
    </p>

    <div class="mono" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:16px;font-size:11px">
      <span style="color:var(--mut2)">{results.length}/{plan.length} recorded · {pct(results.length)}%</span>
      {['finding', 'passed', 'inconclusive', 'blocked', 'pending'].filter((v) => countAll(v)).map((v) => (
        <button class={`vbadge fchip ${V[v].cls}`} data-verdict={v} aria-pressed="false" type="button">
          {V[v].label} {countAll(v)}
        </button>
      ))}
    </div>

    <div class="mono" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:8px;font-size:11px">
      <span style="color:var(--mut2)">layer</span>
      {LAYERS.filter((l) => plan.some((r) => r.layer === l)).map((l) => (
        <button class="vbadge fchip v-layer" data-layer={l} aria-pressed="false" type="button">{l}</button>
      ))}
      <button id="fclear" class="vbadge fchip" type="button" style="color:var(--mut2)">clear</button>
      <span id="fcount" style="color:var(--mut2);margin-left:4px"></span>
    </div>

    <div class="pmap-wrap">
      <div class="pmap">
        <div></div>
        {LAYERS.map((l) => <div class="phead mono">{l}</div>)}
        {mapRows.map((row) => (
          <>
            <div class={`pname mono ${row.scoped ? '' : 'dim'}`}>{row.p.name ?? row.p.id}</div>
            {row.cells.map((c) => (
              <div class={`pcell s-${c.state}`} title={c.title ?? 'no control at this layer'}>{c.label}</div>
            ))}
          </>
        ))}
      </div>
    </div>
    <p class="mono pmap-note">
      {reached} of {corpus.length} controls in the corpus are reached by this engagement.
      Empty cells have no control at that layer; dotted cells have one that this scope does not cover.
    </p>

    <div style="margin-top:22px">
      {plan.map((row) => {
        const r = byControl[row.control];
        const v = r ? r.verdict : 'pending';
        return (
          <div class="vrow" data-verdict={v} data-layer={row.layer}>
            <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
              <span class="mono" style="font-size:10px;color:var(--mut2);width:26px">{row.layer}</span>
              <a href={`/RFSAM/controls/${row.slug}`} class="mono" style="font-size:11.5px;color:var(--amber);width:150px">{row.control}</a>
              <span class={`vbadge ${V[v].cls}`}>{V[v].label}</span>
              {r?.severity && <span class="mono" style={`font-size:10px;color:${SEV[r.severity]}`}>{r.severity}</span>}
              <span class="mono" style="margin-left:auto;font-size:10px;color:var(--mut2)">{r?.method ?? '—'} · {mmss(r?.duration_s)}</span>
              {logByControl[row.control]?.length && (
                <button class="vbadge fchip logbtn" type="button"
                  data-control={row.control}
                  data-log={JSON.stringify(logByControl[row.control])}
                  style="color:var(--cyan)">log {logByControl[row.control].length}</button>
              )}
            </div>
            {r && <p style="font-size:13px;color:#CFD9E4;line-height:1.6;margin:8px 0 0 38px">{r.summary}</p>}
            {r?.stop_reason && <p style="font-size:12.5px;color:var(--mut);line-height:1.6;margin:6px 0 0 38px;border-left:2px solid var(--line2);padding-left:10px"><strong>Why it stopped:</strong> {r.stop_reason}</p>}
            {r?.reason && <p style="font-size:12.5px;color:var(--mut);line-height:1.6;margin:6px 0 0 38px;border-left:2px solid var(--line2);padding-left:10px"><strong>Why blocked:</strong> {r.reason}</p>}
            {r?.suggested_cmd && (
              <div style="margin:8px 0 0 38px">
                <div class="mono" style="font-size:10px;color:var(--mut2);margin-bottom:3px">command handed to the operator</div>
                <pre class="mono" style="font-size:11px;background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:8px 10px;overflow-x:auto">{r.suggested_cmd}</pre>
              </div>
            )}
            {r?.conditions && Object.keys(r.conditions).length > 0 && (
              <p class="mono" style="font-size:10.5px;color:var(--mut2);margin:8px 0 0 38px;line-height:1.8">
                {Object.entries(r.conditions).slice(0, 8).map(([k, val]) => <span style="margin-right:10px">{k}={String(val)}</span>)}
              </p>
            )}
          </div>
        );
      })}
    </div>

    <div id="logmodal" hidden>
      <div class="logbackdrop" data-close></div>
      <div class="logbox" role="dialog" aria-modal="true" aria-labelledby="logtitle">
        <div class="loghead">
          <span class="mono" id="logtitle" style="color:var(--amber);font-size:12px"></span>
          <span class="mono" id="logmeta" style="color:var(--mut2);font-size:10px;margin-left:auto"></span>
          <button class="vbadge fchip" type="button" data-close style="color:var(--mut2);margin-left:10px">esc</button>
        </div>
        <pre class="mono logbody" id="logbody"></pre>
        <div class="mono logfoot">
          simulated execution log · <code>loot/events.jsonl</code>
        </div>
      </div>
    </div>

    <p class="mono" style="font-size:11px;color:var(--mut2);margin-top:28px;line-height:1.7">
      Regenerate the written report with <code>python3 runner/render_report.py --audience client</code>.
      Sources: <code>loot/session_plan.jsonl</code>, <code>loot/results.jsonl</code>, <code>loot/scope.json</code>.
    </p>
  </div>

<script is:inline>
  (() => {
    const rows = [...document.querySelectorAll('.vrow')];
    const chips = [...document.querySelectorAll('.fchip[data-verdict], .fchip[data-layer]')];
    const out = document.getElementById('fcount');

    // Two independent axes, OR inside each and AND between them: picking FINDING
    // and AT means "findings in the attack layer", not "findings plus everything AT".
    const apply = () => {
      const on = (attr) => new Set(
        chips.filter((c) => c.dataset[attr] && c.getAttribute('aria-pressed') === 'true')
             .map((c) => c.dataset[attr]),
      );
      const v = on('verdict'), l = on('layer');
      let shown = 0;
      for (const row of rows) {
        const ok = (!v.size || v.has(row.dataset.verdict)) && (!l.size || l.has(row.dataset.layer));
        row.hidden = !ok;
        if (ok) shown++;
      }
      const filtering = v.size || l.size;
      out.textContent = filtering ? `showing ${shown} of ${rows.length}` : '';
    };

    for (const c of chips) {
      c.addEventListener('click', () => {
        c.setAttribute('aria-pressed', c.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
    document.getElementById('fclear').addEventListener('click', () => {
      for (const c of chips) c.setAttribute('aria-pressed', 'false');
      apply();
    });
    apply();
  })();
</script>

<script is:inline>
  (() => {
    const modal = document.getElementById('logmodal');
    if (!modal) return;
    const body = document.getElementById('logbody');
    const title = document.getElementById('logtitle');
    const meta = document.getElementById('logmeta');
    const esc = (t) => String(t).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
    const cls = (k) => k === 'start' ? 'lk-start' : k === 'done' ? 'lk-done'
                     : k === 'blocked' ? 'lk-block' : 'lk-info';

    const open = (btn) => {
      const rows = JSON.parse(btn.dataset.log);
      title.textContent = btn.dataset.control;
      const t0 = new Date(rows[0].ts).getTime();
      const span = Math.round((new Date(rows[rows.length - 1].ts).getTime() - t0) / 1000);
      meta.textContent = `${rows.length} events · ${span}s wall clock`;
      // Elapsed time from the first event, so the pacing of a run is readable
      // without doing clock arithmetic in your head.
      body.innerHTML = rows.map((e) => {
        const d = Math.round((new Date(e.ts).getTime() - t0) / 1000);
        const stamp = `+${String(Math.floor(d / 60)).padStart(2, '0')}:${String(d % 60).padStart(2, '0')}`;
        return `<span class="lk-info">${stamp}</span>  <span class="${cls(e.kind)}">${esc(e.kind.padEnd(7))}</span>  ${esc(e.msg)}`;
      }).join('\n');
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    };
    const close = () => { modal.hidden = true; document.body.style.overflow = ''; };

    for (const b of document.querySelectorAll('.logbtn')) {
      b.addEventListener('click', () => open(b));
    }
    for (const el of modal.querySelectorAll('[data-close]')) el.addEventListener('click', close);
    document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && !modal.hidden) close(); });
  })();
</script>
</BaseLayout>

<style>
  .vrow { border-top: 1px solid var(--line); padding: 14px 0; }
  .fchip { cursor: pointer; background: transparent; user-select: none; transition: background .12s, opacity .12s; }
  .fchip:hover { background: var(--bg2); }
  /* Unselected chips stay legible: dimming them would hide the counts, which are
     the reason to look at this row in the first place. */
  .fchip[aria-pressed="false"] { opacity: .62; }
  .fchip[aria-pressed="true"] { opacity: 1; background: var(--bg2); box-shadow: inset 0 0 0 1px currentColor; }
  .v-layer { color: var(--mut2); }
  .vrow[hidden] { display: none; }
  /* Execution log modal. A dialog rather than an iframe: the log is already in the
     page, so an iframe would mean a second route and a reload per control. */
  #logmodal[hidden] { display: none; }
  #logmodal { position: fixed; inset: 0; z-index: 50; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .logbackdrop { position: absolute; inset: 0; background: rgba(0,0,0,.66); }
  .logbox { position: relative; width: min(760px, 100%); max-height: 78vh; display: flex; flex-direction: column;
            background: var(--bg2); border: 1px solid var(--line2); border-radius: 8px; overflow: hidden;
            box-shadow: 0 18px 50px rgba(0,0,0,.5); }
  .loghead { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .logbody { margin: 0; padding: 12px 14px; overflow: auto; font-size: 11.5px; line-height: 1.85;
             white-space: pre-wrap; word-break: break-word; }
  .logfoot { padding: 8px 12px; border-top: 1px solid var(--line); font-size: 10px; color: var(--mut2); }
  .logbtn { margin-left: 4px; }
  .lk-start { color: var(--cyan); }
  .lk-info  { color: var(--mut2); }
  .lk-done  { color: var(--green, #98C379); }
  .lk-block { color: var(--orange); }
  /* Progress map: same protocol x layer grid as /mapping, colored by session state
     instead of by corpus coverage, so the two read as the same object. */
  .pmap-wrap { overflow-x: auto; margin-top: 20px; padding-bottom: 4px; }
  .pmap { display: grid; grid-template-columns: 112px repeat(7, minmax(26px, 1fr)); gap: 4px; min-width: 380px; }
  .pmap .phead { font-size: 9.5px; text-align: center; letter-spacing: .06em; color: var(--mut2); align-self: end; padding-bottom: 2px; }
  .pmap .pname { font-size: 11px; color: var(--mut); display: flex; align-items: center; height: 26px;
                 white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 6px; }
  .pmap .pname.dim { color: var(--mut2); opacity: .55; }
  .pmap .pcell { height: 26px; border-radius: 5px; display: flex; align-items: center; justify-content: center;
                 font-size: 10px; border: 1px solid transparent; color: var(--bg); }
  .s-none    { background: transparent; }
  .s-out     { background: var(--bg2); color: var(--mut2); }
  .s-pending { background: transparent; border-color: var(--line2); color: var(--mut2); }
  .s-blocked { background: rgba(224,108,117,.22); border-color: var(--orange); color: var(--orange); }
  .s-finding { background: var(--orange); }
  .s-passed  { background: rgba(63,209,124,.9); }
  .s-inconclusive { background: var(--amber); }
  /* The one cell that is moving right now. */
  .s-running { background: var(--cyan); color: var(--bg); animation: ppulse 1.1s ease-in-out infinite; }
  @keyframes ppulse { 0%,100% { opacity: 1 } 50% { opacity: .45 } }
  @media (prefers-reduced-motion: reduce) { .s-running { animation: none } }
  .pmap-note { font-size: 10.5px; color: var(--mut2); margin-top: 10px; line-height: 1.7; }
  .vbadge { font-family: var(--mono); font-size: 10px; padding: 2px 7px; border-radius: 3px; border: 1px solid var(--line2); letter-spacing: .06em; }
  .v-finding { color: var(--orange); border-color: var(--orange); }
  .v-passed { color: var(--green); border-color: var(--green); }
  .v-inconc { color: var(--amber); border-color: var(--amber); }
  .v-blocked { color: var(--mut2); }
  .v-pending { color: var(--mut2); border-style: dashed; }
</style>
